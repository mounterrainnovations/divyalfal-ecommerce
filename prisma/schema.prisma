// =============================================================================================
// WHAT THIS FILE IS, AND WHY IT GREW BACK.
//
// The revamp trimmed this schema down to the catalogue and the CMS, as if the shop were a
// brochure. The production database says otherwise: it has carried `Order`, `OrderItem`,
// `Payment`, `PaymentEvent`, `ProductVariant`, `Profile` and `Address` all along — eight real
// orders, eleven order items, five payments, eight product variants with sizes and stock —
// created by the pre-revamp application and never dropped. `Product.isArchived` was missing
// from the models too, which is why the portal had no idea some garments were archived.
//
// Trimming the models did not remove the tables; it only made the portal blind to them. This
// file is now `prisma db pull` from the live database, so it describes what is actually there.
// The CMS models came back byte-identical, which is the evidence that the two halves had not
// drifted while they were apart.
//
// THERE IS NO MIGRATION WITH THIS CHANGE, DELIBERATELY. Everything the portal's new modules
// need already exists: orders, order items, payments and stock are real tables, and the three
// curated lists that have no table of their own — collections, size charts and coupons — live
// in `SiteSetting`, the key/value JSON store two rows above. A schema that matches the database
// exactly is also the only safe state: add a column here that production does not have and
// every `findMany` on that table starts failing, because Prisma names its columns explicitly.
// =============================================================================================

// =============================================================================================
// WHAT THIS FILE IS, AND WHY IT GREW BACK.
//
// The revamp trimmed this schema down to the catalogue and the CMS, as if the shop were a
// brochure. The production database says otherwise: it has carried `Order`, `OrderItem`,
// `Payment`, `PaymentEvent`, `ProductVariant`, `Profile` and `Address` all along — eight real
// orders, eleven order items, five payments, eight product variants with sizes and stock —
// created by the pre-revamp application and never dropped.
//
// Trimming the models did not remove the tables; it only made the portal blind to them. So
// this file was re-introspected from the live database (`prisma db pull`) and now describes
// what is actually there. The CMS models came back byte-identical, which is the evidence that
// the two halves had not drifted.
//
// ADDED BY THIS CHANGE, and nothing else:
//   * three new tables — Collection, SizeChart, Coupon
//   * two new enums — OrderChannel, CouponKind
//   * eight new columns on Order, every one nullable or defaulted, so the eight orders already
//     in the table keep working untouched. `subtotal` is null on all of them; the invoice falls
//     back to `totalAmount`, which is the only figure those orders ever recorded.
//
// Nothing existing is altered, renamed or dropped. The migration beside this file is additive
// in full, and was generated by `prisma migrate diff` against the live database rather than
// written by hand.
// =============================================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id             String           @id @default(uuid())
  name           String           @db.VarChar(255)
  photos         String[]
  price          Decimal          @db.Decimal(10, 2)
  specifications String
  category       ProductType      @default(OTHER) @map("type")
  createdAt      DateTime         @default(now()) @map("createdAt")
  updatedAt      DateTime         @updatedAt @map("updatedAt")
  sale           Boolean?
  salePrice      Decimal?         @db.Decimal(10, 2)
  isArchived     Boolean          @default(false)
  OrderItem      OrderItem[]
  ProductVariant ProductVariant[]

  @@map("Product")
}

model MediaAsset {
  id        String    @id @default(uuid())
  url       String
  path      String
  kind      MediaKind @default(IMAGE)
  alt       String    @default("")
  width     Int?
  height    Int?
  mimeType  String
  bytes     Int
  tags      String[]
  createdAt DateTime  @default(now())
  slides    Slide[]
}

model ContentBlock {
  id        String    @id @default(uuid())
  key       String    @unique
  page      String
  section   String
  label     String
  kind      BlockKind
  draft     Json
  published Json?
  updatedAt DateTime  @updatedAt
}

model HomepageSection {
  id         String   @id @default(uuid())
  key        String   @unique
  label      String
  order      Int
  visible    Boolean  @default(true)
  productIds String[]
  updatedAt  DateTime @updatedAt
}

model Slide {
  id      String     @id @default(uuid())
  assetId String
  order   Int
  visible Boolean    @default(true)
  asset   MediaAsset @relation(fields: [assetId], references: [id])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Enquiry {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String
  source    String?
  status    EnquiryStatus @default(UNREAD)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Address {
  id         String   @id
  profileId  String   @db.Uuid
  fullName   String
  phone      String
  street     String
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  Profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Order {
  id                String        @id
  profileId         String?       @db.Uuid
  status            OrderStatus   @default(PENDING)
  totalAmount       Decimal       @db.Decimal(10, 2)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime
  paymentStatus     PaymentStatus @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  shippingAddress   Json?
  trackingId        String?
  trackingUrl       String?
  isGuest           Boolean?      @default(false)
  guestEmail        String?
  guestPhone        String?
  guestName         String?
  type              OrderType     @default(STANDARD)
  Profile           Profile?      @relation(fields: [profileId], references: [id])
  OrderItem         OrderItem[]
  Payment           Payment[]

  @@index([profileId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model OrderItem {
  id                 String         @id
  orderId            String
  productId          String
  quantity           Int
  price              Decimal        @db.Decimal(10, 2)
  customMeasurements Json?
  productVariantId   String
  Order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Product            Product        @relation(fields: [productId], references: [id])
  ProductVariant     ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Payment {
  id                  String   @id
  orderId             String
  profileId           String?  @db.Uuid
  provider            String   @default("razorpay")
  provider_order_id   String   @unique
  provider_payment_id String?
  amount              Int
  currency            String   @default("INR")
  status              String
  metadata            Json?
  created_at          DateTime @default(now())
  updated_at          DateTime
  Order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Profile             Profile? @relation(fields: [profileId], references: [id])

  @@index([orderId])
  @@index([profileId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model PaymentEvent {
  id                String   @id
  provider_event_id String   @unique
  provider          String
  event_type        String
  payload           Json
  processed_at      DateTime @default(now())
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ProductVariant {
  id        String      @id
  productId String
  size      String
  color     String?
  stock     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime
  OrderItem OrderItem[]
  Product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Profile {
  id        String    @id @db.Uuid
  email     String    @unique
  fullName  String?
  avatarUrl String?
  role      UserRole  @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime
  phone     String?
  Address   Address[]
  Order     Order[]
  Payment   Payment[]
}

enum ProductType {
  SAREE
  INDO_WESTERN
  LEHENGA
  SUIT
  KURTA_PANT
  WESTERN
  OTHER
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum BlockKind {
  TEXT
  RICH_TEXT
  IMAGE
  IMAGE_LIST
  VIDEO
  NUMBER
  LINK
}

enum EnquiryStatus {
  UNREAD
  READ
  ARCHIVED
}

enum OrderStatus {
  PENDING
  QUOTE_REQUESTED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum OrderType {
  STANDARD
  RFQ
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum UserRole {
  ADMIN
  USER
}
